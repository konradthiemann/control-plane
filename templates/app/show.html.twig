{% extends '_layout/shell.html.twig' %}

{% block title %}{{ appEntry.displayName }} — Control Plane{% endblock %}

{% block page %}
    <div class="page-header">
        <h1>{{ appEntry.displayName }}</h1>
        <div class="meta">
            <a href="https://github.com/konradthiemann/{{ appEntry.githubRepo }}" target="_blank" rel="noopener">GitHub-Repo →</a>
        </div>
    </div>

    {% if appEntry.hasKnipsAnalytics %}
        {% if knipsStats is null and knipsAnalytics is null %}
            <div class="card">
                <p class="empty-state">Knips aktuell nicht erreichbar.</p>
            </div>
        {% else %}
            {% if knipsStats %}
                {% set expiringSoon = knipsStats.totals.events - knipsStats.totals.activeEvents %}
                <div class="kpi-row">
                    <div class="kpi-tile">
                        <div class="value">{{ knipsStats.totals.activeEvents }}</div>
                        <div class="label" data-tooltip="Events innerhalb der 30-Tage-Aufbewahrung — noch voll nutzbar/abrufbar.">Aktiv</div>
                    </div>
                    <div class="kpi-tile">
                        <div class="value">{{ expiringSoon }}</div>
                        <div class="label" data-tooltip="Über der 30-Tage-Aufbewahrung — werden binnen der nächsten Stunde automatisch endgültig gelöscht (keine separate Nachfrist).">Läuft in Kürze ab</div>
                    </div>
                    <div class="kpi-tile">
                        <div class="value">{{ knipsStats.totals.guests }}</div>
                        <div class="label" data-tooltip="Summe aller Gäste über alle Events hinweg.">Gäste gesamt</div>
                    </div>
                    <div class="kpi-tile">
                        <div class="value">{{ knipsStats.totals.photos }}</div>
                        <div class="label" data-tooltip="Summe aller hochgeladenen Fotos über alle Events hinweg.">Fotos gesamt</div>
                    </div>
                    <div class="kpi-tile">
                        <div class="value">{{ (knipsStats.totals.revenueCents / 100)|number_format(2, ',', '.') }} €</div>
                        <div class="label" data-tooltip="Einmalpreis je Event nach gewähltem Preis-Tier, § 19 UStG (keine USt.).">Umsatz</div>
                    </div>
                    {% if knipsStorage %}
                        <div class="kpi-tile">
                            <div class="value">{% set mb = knipsStorage.totalBytes / 1024 / 1024 %}{% if mb > 1024 %}{{ (mb / 1024)|number_format(2, ',', '.') }} GB{% else %}{{ mb|number_format(1, ',', '.') }} MB{% endif %}</div>
                            <div class="label" data-tooltip="Speicherplatz aller hochgeladenen Fotos auf dem Railway-Volume ({{ knipsStorage.fileCount }} Dateien).">Speicher belegt</div>
                        </div>
                    {% endif %}
                </div>

                <div class="card">
                    <h2>Verlauf (30 Tage)</h2>
                    <h3>Fotos pro Tag</h3>
                    <div class="chart-box">
                        {{ render_chart(knipsCharts.photosPerDay) }}
                    </div>
                    <h3>Gäste pro Tag</h3>
                    <div class="chart-box chart-box--short">
                        {{ render_chart(knipsCharts.guestsPerDay) }}
                    </div>
                    <h3>Events pro Tag</h3>
                    <div class="chart-box chart-box--short">
                        {{ render_chart(knipsCharts.eventsPerDay) }}
                    </div>
                </div>

                <div class="card">
                    <h2>Tageszeit-Verteilung</h2>
                    <p class="meta" style="margin-top: -0.5rem;">Zu welcher Uhrzeit (Europe/Berlin) im Schnitt die meisten Fotos gemacht werden — über alle Events hinweg.</p>
                    <div class="chart-box">
                        {{ render_chart(knipsCharts.photosByHour) }}
                    </div>
                </div>

                <div class="card">
                    <h2>Preis-Tiers</h2>
                    <p class="meta" style="margin-top: -0.5rem;">Welches Guest-Limit beim Anlegen eines Events gewählt wurde.</p>
                    <div class="chart-box">
                        {{ render_chart(knipsCharts.tiers) }}
                    </div>
                </div>

                <div class="card">
                    <h2>Events</h2>
                    {{ component('KnipsEventBoard') }}
                </div>
            {% endif %}

            {% if knipsAnalytics %}
                <div class="card">
                    <h2>Analytics</h2>

                    <h3>Funnel</h3>
                    <div class="chart-box">
                        {{ render_chart(knipsCharts.funnel) }}
                    </div>

                    <h3>Geräte</h3>
                    <div class="chart-box chart-box--short">
                        {{ render_chart(knipsCharts.devices) }}
                    </div>

                    <h3>Uploads nach Kategorie</h3>
                    <div class="chart-box">
                        {{ render_chart(knipsCharts.uploads) }}
                    </div>

                    <h3>Übersprungen nach Kategorie</h3>
                    <div class="chart-box">
                        {{ render_chart(knipsCharts.skips) }}
                    </div>
                </div>

                {% if knipsTaskRanking %}
                    {{ include('app/_knips_task_performance.html.twig', {r: knipsTaskRanking}) }}
                {% endif %}
            {% endif %}
        {% endif %}
    {% endif %}

    {% if appEntry.hasDoeweAnalytics %}
        <div class="card">
            <h2>Kennzahlen</h2>

            {% if doeweStats is null %}
                <p class="empty-state">Doewe aktuell nicht erreichbar.</p>
            {% else %}
                <div class="kpi-row">
                    <div class="kpi-tile">
                        <div class="value">{{ doeweStats.households.total }}</div>
                        <div class="label" data-tooltip="Alle Haushalte, unabhängig ob aktiv genutzt.">Haushalte</div>
                    </div>
                    <div class="kpi-tile">
                        <div class="value">{{ doeweStats.households.multiMember }}</div>
                        <div class="label" data-tooltip="Haushalte mit mehr als einem Mitglied — nutzt das Sharing-Feature wirklich jemand?">davon Multi-Member</div>
                    </div>
                    <div class="kpi-tile">
                        <div class="value">{{ doeweStats.users.total }}</div>
                        <div class="label" data-tooltip="Registrierte Nutzer über alle Haushalte hinweg.">Nutzer</div>
                    </div>
                    <div class="kpi-tile">
                        <div class="value">{{ doeweStats.accounts.total }}</div>
                        <div class="label" data-tooltip="Konten über alle Haushalte hinweg.">Konten</div>
                    </div>
                    <div class="kpi-tile">
                        <div class="value">{{ doeweStats.transactions.total }}</div>
                        <div class="label" data-tooltip="Alle erfassten Transaktionen (ohne soft-gelöschte).">Transaktionen</div>
                    </div>
                    <div class="kpi-tile">
                        <div class="value">{% set mb = doeweStats.attachments.totalBytes / 1024 / 1024 %}{% if mb > 1024 %}{{ (mb / 1024)|number_format(2, ',', '.') }} GB{% else %}{{ mb|number_format(1, ',', '.') }} MB{% endif %}</div>
                        <div class="label" data-tooltip="Speicherplatz aller Beleg-Anhänge ({{ doeweStats.attachments.count }} Dateien).">Anhänge-Speicher</div>
                    </div>
                    <div class="kpi-tile">
                        <div class="value">{{ doeweStats.recurringTransactions.active }}</div>
                        <div class="label" data-tooltip="Aktive wiederkehrende Buchungen (nicht soft-gelöscht).">Wiederkehrend</div>
                    </div>
                    <div class="kpi-tile">
                        <div class="value">{{ doeweStats.budgets.total }}</div>
                        <div class="label" data-tooltip="Kategorie-Budgets + Sparziele zusammen ({{ doeweStats.budgets.completed }} abgeschlossen). Die App selbst trennt beide Typen nicht sauber in der Datenbank.">Budgets</div>
                    </div>
                </div>

                <h3>Transaktions-Datenqualität</h3>
                <p class="meta" style="margin-top: -0.5rem;">Von {{ doeweStats.transactions.total }} Transaktionen insgesamt.</p>
                <div class="chart-box">
                    {{ render_chart(doeweChart) }}
                </div>
            {% endif %}
        </div>
    {% endif %}

    {% if appEntry.hasDoeweCrm %}
        {% if doeweUsageCharts %}
            <div class="card">
                <h2>Verlauf (30 Tage)</h2>
                <h3>Logins pro Tag</h3>
                <div class="chart-box chart-box--short">
                    {{ render_chart(doeweUsageCharts.logins) }}
                </div>
                <h3>Transaktionen pro Tag</h3>
                <div class="chart-box chart-box--short">
                    {{ render_chart(doeweUsageCharts.transactions) }}
                </div>
                <h3>Beleg-Scans pro Tag</h3>
                <div class="chart-box chart-box--short">
                    {{ render_chart(doeweUsageCharts.receiptScans) }}
                </div>
            </div>
        {% else %}
            <div class="card">
                <p class="empty-state">Doewe-Nutzungsdaten aktuell nicht erreichbar.</p>
            </div>
        {% endif %}

        <div class="card">
            <h2>Nutzer &amp; Haushalte</h2>
            {{ component('DoeweCrmBoard') }}
        </div>
    {% endif %}

    <div class="card">
        <h2>Offene Issues</h2>
        {{ component('IssueBoard', {repoFilter: appEntry.githubRepo}) }}
    </div>
{% endblock %}
