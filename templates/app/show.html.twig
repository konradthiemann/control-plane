{% extends '_layout/shell.html.twig' %}

{% block title %}{{ appEntry.displayName }} — Control Plane{% endblock %}

{% block page %}
    <div class="page-header">
        <h1>{{ appEntry.displayName }}</h1>
        <div class="meta">
            <a href="https://github.com/konradthiemann/{{ appEntry.githubRepo }}" target="_blank" rel="noopener">GitHub-Repo →</a>
        </div>
    </div>

    {% if appEntry.hasKnipsAnalytics %}
        {% if knipsStats is null and knipsAnalytics is null %}
            <div class="card">
                <p class="empty-state">Knips aktuell nicht erreichbar.</p>
            </div>
        {% else %}
            {% if knipsStats %}
                <div class="kpi-row">
                    <div class="kpi-tile">
                        <div class="value">{{ knipsStats.totals.events }}</div>
                        <div class="label" data-tooltip="Alle jemals angelegten Events, inkl. abgelaufener (Retention 30 Tage).">Events</div>
                    </div>
                    <div class="kpi-tile">
                        <div class="value">{{ knipsStats.totals.guests }}</div>
                        <div class="label" data-tooltip="Summe aller Gäste über alle Events hinweg.">Gäste gesamt</div>
                    </div>
                    <div class="kpi-tile">
                        <div class="value">{{ knipsStats.totals.photos }}</div>
                        <div class="label" data-tooltip="Summe aller hochgeladenen Fotos über alle Events hinweg.">Fotos gesamt</div>
                    </div>
                    <div class="kpi-tile">
                        <div class="value">{{ (knipsStats.totals.revenueCents / 100)|number_format(2, ',', '.') }} €</div>
                        <div class="label" data-tooltip="Einmalpreis je Event nach gewähltem Preis-Tier, § 19 UStG (keine USt.).">Umsatz</div>
                    </div>
                </div>

                <div class="card">
                    <h2>Verlauf (30 Tage)</h2>
                    <h3>Fotos pro Tag</h3>
                    <div class="chart-box">
                        {{ render_chart(knipsCharts.photosPerDay) }}
                    </div>
                    <h3>Gäste pro Tag</h3>
                    <div class="chart-box chart-box--short">
                        {{ render_chart(knipsCharts.guestsPerDay) }}
                    </div>
                    <h3>Events pro Tag</h3>
                    <div class="chart-box chart-box--short">
                        {{ render_chart(knipsCharts.eventsPerDay) }}
                    </div>
                </div>

                <div class="card">
                    <h2>Preis-Tiers</h2>
                    <p class="meta" style="margin-top: -0.5rem;">Welches Guest-Limit beim Anlegen eines Events gewählt wurde.</p>
                    <div class="chart-box">
                        {{ render_chart(knipsCharts.tiers) }}
                    </div>
                </div>

                <div class="card">
                    <h2>Events</h2>
                    <table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th data-tooltip="Gekauftes Gäste-Limit (Preis-Tier) beim Anlegen des Events.">Limit</th>
                                <th data-tooltip="Tatsächlich beigetretene Gäste.">Gäste</th>
                                <th data-tooltip="Gäste im Verhältnis zum gekauften Limit (Gäste ÷ Limit).">Auslastung</th>
                                <th data-tooltip="Hochgeladene Fotos in diesem Event.">Fotos</th>
                                <th data-tooltip="Einmalpreis für dieses Event nach Preis-Tier.">Preis</th>
                                <th data-tooltip="Aktiv = Event noch nicht abgelaufen (Retention 30 Tage).">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for event in knipsStats.events %}
                                <tr>
                                    <td>{{ event.name }}</td>
                                    <td>{{ event.guestLimit }}</td>
                                    <td>{{ event.guestCount }}</td>
                                    <td>{{ event.guestLimit > 0 ? ((event.guestCount / event.guestLimit * 100)|round) ~ ' %' : '—' }}</td>
                                    <td>{{ event.photoCount }}</td>
                                    <td>{{ (event.priceCents / 100)|number_format(2, ',', '.') }} €</td>
                                    <td><span class="badge {{ event.active ? 'badge-addressing' : 'badge-dismissed' }}">{{ event.active ? 'aktiv' : 'beendet' }}</span></td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            {% if knipsAnalytics %}
                <div class="card">
                    <h2>Analytics</h2>

                    <h3>Funnel</h3>
                    <div class="chart-box">
                        {{ render_chart(knipsCharts.funnel) }}
                    </div>

                    <h3>Geräte</h3>
                    <div class="chart-box chart-box--short">
                        {{ render_chart(knipsCharts.devices) }}
                    </div>

                    <h3>Uploads nach Kategorie</h3>
                    <div class="chart-box">
                        {{ render_chart(knipsCharts.uploads) }}
                    </div>

                    <h3>Übersprungen nach Kategorie</h3>
                    <div class="chart-box">
                        {{ render_chart(knipsCharts.skips) }}
                    </div>
                </div>
            {% endif %}
        {% endif %}
    {% endif %}

    <div class="card">
        <h2>Offene Issues</h2>
        {{ component('IssueBoard', {repoFilter: appEntry.githubRepo}) }}
    </div>
{% endblock %}
