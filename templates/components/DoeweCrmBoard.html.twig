<div {{ attributes }}>
    {% if this.lastError %}
        <div class="alert alert-danger">{{ this.lastError }}</div>
    {% endif %}

    <h3>Nutzer</h3>
    {% if this.users is empty %}
        <p class="empty-state">Keine Nutzer.</p>
    {% else %}
        <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>E-Mail</th>
                    <th>Name</th>
                    <th data-tooltip="ID des Haushalts, dem dieser Nutzer angehört.">Haushalt</th>
                    <th>Status</th>
                    <th data-tooltip="Letzter erfolgreicher Login. Leer, wenn noch nie eingeloggt.">Letzter Login</th>
                    <th>Aktion</th>
                </tr>
            </thead>
            <tbody>
                {% for user in this.users %}
                    <tr>
                        <td data-label="E-Mail">{{ user.email }}</td>
                        <td data-label="Name">{{ user.name ?? '—' }}</td>
                        <td data-label="Haushalt">{{ user.householdId ?? '—' }}</td>
                        <td data-label="Status">
                            {% if user.deletedAt %}
                                <span class="badge badge-dismissed">gelöscht</span>
                            {% elseif user.suspendedAt %}
                                <span class="badge badge-addressing">gesperrt</span>
                            {% else %}
                                <span class="badge badge-new">aktiv</span>
                            {% endif %}
                        </td>
                        <td data-label="Letzter Login">{{ user.lastLoginAt ? user.lastLoginAt|date('d.m.Y H:i') : '—' }}</td>
                        <td class="actions">
                            {% if not user.deletedAt %}
                                {% if user.suspendedAt %}
                                    <button {{ live_action('suspendUser', {userId: user.id, suspended: false}) }}>Entsperren</button>
                                {% else %}
                                    <button {{ live_action('suspendUser', {userId: user.id, suspended: true}) }}>Sperren</button>
                                {% endif %}
                                <button
                                    {{ live_action('deleteUser', {userId: user.id}) }}
                                    onclick="if(!confirm('Nutzer „{{ user.email|e('js') }}“ wirklich löschen (Soft-Delete)?')){event.preventDefault();event.stopImmediatePropagation();}"
                                >Löschen</button>
                            {% else %}
                                <span class="meta">—</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    {% endif %}

    <h3 style="margin-top: 1.5rem;">Haushalte</h3>
    {% if this.households is empty %}
        <p class="empty-state">Keine Haushalte.</p>
    {% else %}
        <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Mitglieder</th>
                    <th>Konten</th>
                    <th>Transaktionen</th>
                    <th data-tooltip="Erfasste Beleg-Scans dieses Haushalts — informiert eine künftige Preis-Tier-Entscheidung.">Beleg-Scans</th>
                    <th>Erstellt</th>
                    <th>Mitglied abspalten</th>
                    <th>Aktion</th>
                </tr>
            </thead>
            <tbody>
                {% for household in this.households %}
                    <tr>
                        <td data-label="Name">{{ household.name ?? '—' }}</td>
                        <td data-label="Mitglieder">{{ household.memberCount }}</td>
                        <td data-label="Konten">{{ household.accountsCount }}</td>
                        <td data-label="Transaktionen">{{ household.transactionsCount }}</td>
                        <td data-label="Beleg-Scans">{{ household.receiptScanCount }}</td>
                        <td data-label="Erstellt">{{ household.createdAt|date('d.m.Y') }}</td>
                        <td class="actions" data-label="Mitglied abspalten">
                            {% set members = this.users|filter(u => u.householdId == household.id) %}
                            {% if members is empty %}
                                <span class="meta">keine Mitglieder</span>
                            {% else %}
                                {% for member in members %}
                                    <button
                                        {{ live_action('splitMember', {householdId: household.id, userId: member.id}) }}
                                        onclick="if(!confirm('„{{ member.email|e('js') }}“ wirklich in einen eigenen, neuen Haushalt abspalten?')){event.preventDefault();event.stopImmediatePropagation();}"
                                    >{{ member.email }} abspalten</button>
                                {% endfor %}
                            {% endif %}
                        </td>
                        <td class="actions" data-label="Aktion">
                            <button
                                {{ live_action('deleteHousehold', {householdId: household.id}) }}
                                onclick="if(!confirm('Haushalt „{{ (household.name ?? household.id)|e('js') }}“ wirklich komplett löschen? Alle {{ household.memberCount }} Mitglieder verlieren den Zugriff.')){event.preventDefault();event.stopImmediatePropagation();}"
                            >Löschen</button>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    {% endif %}
</div>
